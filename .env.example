APP_NAME=Backend Stack Template
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
ENABLE_SECURITY_HEADERS=true
ENABLE_API_DOCS=true
ENABLE_DEV_ROUTES=true
REQUIRE_DEV_ROUTE_AUTH=true
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
TRUSTED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend_stack_template
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/backend_stack_template

BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

RESEND_API_KEY=replace-me
EMAIL_FROM=Backend Stack Template <onboarding@resend.dev>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=

SUPABASE_URL=replace-me
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_UPLOADS_BUCKET=uploads

REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=1
JOB_ATTEMPTS=2
JOB_BACKOFF_DELAY_MS=1000
JOB_REMOVE_ON_COMPLETE=100
JOB_REMOVE_ON_FAIL=100
DLQ_REMOVE_ON_COMPLETE=500
DLQ_REMOVE_ON_FAIL=500

INTERNAL_API_KEY=replace-with-a-random-internal-key-at-least-32-characters
