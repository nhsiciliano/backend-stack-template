APP_NAME=Backend Stack Template
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
ENABLE_SECURITY_HEADERS=true
ENABLE_API_DOCS=false
ENABLE_INTERNAL_ROUTES=false
ENABLE_DEV_ROUTES=false
REQUIRE_DEV_ROUTE_AUTH=true
CORS_ORIGIN=https://app.example.com
TRUSTED_ORIGINS=https://app.example.com

DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/database?sslmode=require

BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=https://api.example.com

RESEND_API_KEY=replace-me
EMAIL_FROM=Backend Stack Template <no-reply@example.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_UPLOADS_BUCKET=uploads

REDIS_URL=redis://user:password@host:6379
WORKER_CONCURRENCY=2
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY_MS=1000
JOB_REMOVE_ON_COMPLETE=1000
JOB_REMOVE_ON_FAIL=1000
DLQ_REMOVE_ON_COMPLETE=1000
DLQ_REMOVE_ON_FAIL=1000

INTERNAL_API_KEY=replace-with-a-random-internal-key-at-least-32-characters
